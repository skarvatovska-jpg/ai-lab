# Telegram Bot Token (отримайте у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (отримайте на https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Шлях до бази даних (за замовчуванням career_twin.db)
DATABASE_PATH=career_twin.db

# Модель OpenAI (рекомендовано: gpt-4o-mini для швидкості або gpt-4o для точності)
OPENAI_MODEL=gpt-4o-mini

